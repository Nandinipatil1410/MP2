# Privacy-Preserving Hybrid LLM System - Environment Variables

# Cloud API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override judge model (default: gemini-flash-latest when GEMINI_API_KEY is set)
GEMINI_JUDGE_MODEL=gemini-flash-latest

# Model Configuration
LOCAL_MODEL=mistral
CLOUD_MODEL=llama3-70b-8192
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Paths
VECTOR_DB_PATH=./data/vector_db
DOCUMENTS_PATH=./data/documents

# System Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=3
